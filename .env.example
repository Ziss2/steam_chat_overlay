# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore ไว้แล้ว)

# YouTube Data API v3 key (ใช้เฉพาะเมื่อ youtube.mode = "api" หรือ "auto")
# สร้างได้ที่ https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# พอร์ตของ overlay server (ค่าเริ่มต้น 4700) — ทับค่าใน config.json
PORT=

# ที่อยู่ที่รอรับเชื่อมต่อ (ค่าเริ่มต้นใน config.json / DEFAULT_CONFIG คือ 0.0.0.0 = รับได้ทุกอินเทอร์เฟซ)
#   127.0.0.1 = จำกัดเฉพาะในเครื่องนี้
#   0.0.0.0   = รับได้ทุกอินเทอร์เฟซ (แนะนำเมื่อต่อผ่าน VPN/เครือข่ายอื่น)
HOST=0.0.0.0

# ระดับ log: debug | info | warn | error
LOG_LEVEL=info
